TORBOX_API_KEY=
MOUNT_METHOD=strm
MOUNT_PATH=/torbox
ENABLE_METADATA=false
MOUNT_REFRESH_TIME=slow
RAW_MODE=false
# TMDB API key (v3 auth, separate from TorBox)
TMDB_API_KEY=
METADATA_LANGUAGE=pl-PL

# Provider order; Kitsu needs no key, TVDB is skipped without its key
METADATA_PROVIDERS=tmdb,tvdb,kitsu
TVDB_API_KEY=
# Required only for subscriber-supported TVDB keys
TVDB_PIN=
